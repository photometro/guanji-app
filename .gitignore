# 依赖
node_modules/

# Android 构建产物 / 机器相关
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
android/*.iml
android/app/.cxx/
android/app/release/

# Capacitor 同步生成（由 npx cap sync 重新生成）
android/app/src/main/assets/

# 调试残留
build-err*.txt
logcat*.txt
build-log.txt
*.log

# 截图存档
screenshots/

# 真机调试临时产物（不入库：截图 / uiautomator 转储 / 采样输出 / 临时脚本；调试脚本本身入库）
debug/
# 注意：gitignore 不支持行内注释——规则行内不能带 # 后缀（原 debug/*.cjs 行内注释导致规则失效，已收敛为整目录）

# 实施记录文档（不入库——2026-08-19 决策：与历史实施记录一致，仅本地保留）
实施v*.md
