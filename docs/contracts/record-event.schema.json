{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanji.app/contracts/record-event.schema.json",
  "title": "Guanji RecordEvent",
  "type": "object",
  "x-preserveUnknownFields": true,
  "required": ["schemaVersion", "id", "occurredAtMs", "zoneId", "localDateKey", "source", "timePrecision"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "occurredAtMs": { "type": "integer", "minimum": 0 },
    "zoneId": { "type": "string", "minLength": 1 },
    "localDateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "offset": { "type": "integer" },
    "time": { "type": "string" },
    "timePrecision": { "type": "string", "enum": ["minute", "second", "unknown"] },
    "source": { "type": "string", "enum": ["now", "timer", "backfill", "quick", "import", "legacy", "demo"] },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "backfill": { "type": "boolean" },
    "duration": { "type": ["integer", "null"], "minimum": 0 },
    "observations": { "type": "array", "items": { "type": "string" } },
    "observation": { "type": ["string", "null"] },
    "moods": { "type": "array", "items": { "type": "string" } },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "media": { "type": "boolean" },
    "note": { "type": "string" },
    "createdAtMs": { "type": "integer", "minimum": 0 },
    "updatedAtMs": { "type": "integer", "minimum": 0 }
  }
}
