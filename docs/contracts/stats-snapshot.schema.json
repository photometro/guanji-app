{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanji.app/contracts/stats-snapshot.schema.json",
  "title": "Guanji StatsSnapshot",
  "type": "object",
  "x-preserveUnknownFields": true,
  "required": ["schemaVersion", "statsRuleVersion", "generationId", "revision", "generatedAtMs", "timezone", "todayKey", "weekStartKey", "weekEndKey", "monthStartKey", "todayCount", "weekCount", "weekCounts", "streak", "rolling14", "rolling30", "freshness"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "statsRuleVersion": { "type": "string", "minLength": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "generatedAtMs": { "type": "integer", "minimum": 0 },
    "timezone": { "type": "string", "minLength": 1 },
    "todayKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weekStartKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weekEndKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "monthStartKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "todayCount": { "type": "integer", "minimum": 0 },
    "weekCount": { "type": "integer", "minimum": 0 },
    "weekCounts": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "integer", "minimum": 0 } },
    "weekDayIndex": { "type": "integer", "minimum": 0, "maximum": 6 },
    "weekDelta": { "type": ["integer", "null"] },
    "previousWeekCount": { "type": "integer", "minimum": 0 },
    "monthCount": { "type": "integer", "minimum": 0 },
    "monthDelta": { "type": ["integer", "null"] },
    "previousMonthCount": { "type": "integer", "minimum": 0 },
    "streak": { "type": "integer", "minimum": 0 },
    "rolling7Count": { "type": "integer", "minimum": 0 },
    "rolling14": { "type": "array", "minItems": 14, "maxItems": 14, "items": { "type": "integer", "minimum": 0 } },
    "rolling30": { "type": "array", "minItems": 30, "maxItems": 30, "items": { "type": "integer", "minimum": 0 } },
    "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
    "excludedInvalidRecords": { "type": "integer", "minimum": 0 },
    "excludedFutureRecords": { "type": "integer", "minimum": 0 },
    "dataQuality": {
      "type": "object",
      "required": ["windowDays", "coverageDays", "coverageRatio", "sourceCounts", "backfillCount", "backfillRatio", "completenessRatio", "status"],
      "properties": {
        "windowDays": { "type": "integer", "minimum": 1 },
        "windowStartKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "windowEndKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "recordCount": { "type": "integer", "minimum": 0 },
        "coverageDays": { "type": "integer", "minimum": 0 },
        "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceCounts": { "type": "object" },
        "backfillCount": { "type": "integer", "minimum": 0 },
        "backfillRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "timePrecisionCounts": { "type": "object" },
        "metadataCompleteCount": { "type": "integer", "minimum": 0 },
        "completenessRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "type": "string", "enum": ["insufficient", "partial", "usable"] },
        "excludedInvalidRecords": { "type": "integer", "minimum": 0 },
        "excludedFutureRecords": { "type": "integer", "minimum": 0 },
        "excludedRecords": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
