{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guanji.app/contracts/behavior-model-snapshot.schema.json",
  "title": "Guanji BehaviorModelSnapshot",
  "type": "object",
  "x-preserveUnknownFields": true,
  "required": ["schemaVersion", "modelVersion", "dataRevision", "generatedAtMs", "timezone", "statsSnapshot", "baseline", "deviations", "persistence", "quality", "personalSignature"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "dataRevision": { "type": "integer", "minimum": 0 },
    "generatedAtMs": { "type": "integer", "minimum": 0 },
    "timezone": { "type": "string", "minLength": 1 },
    "statsSnapshot": { "type": "object" },
    "statsEngineVersion": { "type": "string", "minLength": 1 },
    "baseline": { "type": "object" },
    "deviations": { "type": "array", "items": { "type": "object" } },
    "persistence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "ruleVersion", "state", "confidence", "evidenceBlocks", "limitations"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "ruleVersion": { "type": "string", "minLength": 1 },
          "state": { "enum": ["stable", "single_shift", "repeated_shift", "returning", "uncertain"] },
          "direction": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidenceBlocks": { "type": "array", "items": { "type": "object" } },
          "changePoint": {
            "type": "object",
            "required": ["status", "method", "confidence", "evidenceBlockIds", "limitations"],
            "properties": {
              "status": { "enum": ["candidate", "not_detected", "uncertain"] },
              "method": { "type": "string", "minLength": 1 },
              "direction": { "type": "string" },
              "confidence": { "enum": ["high", "medium", "low"] },
              "startWeekStartKey": { "type": "string" },
              "startWeekEndKey": { "type": "string" },
              "endWeekStartKey": { "type": "string" },
              "endWeekEndKey": { "type": "string" },
              "evidenceBlockIds": { "type": "array", "items": { "type": "string" } },
              "shiftedBlockCount": { "type": "integer", "minimum": 0 },
              "limitations": { "type": "array", "items": { "type": "string" } }
            },
            "x-preserveUnknownFields": true
          },
          "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "x-preserveUnknownFields": true
      }
    },
    "quality": { "type": "object" },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to", "relation", "confidence", "evidenceBlockIds", "limitations"],
        "properties": {
          "type": { "enum": ["event_cooccurrence", "temporal_co_movement"] },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["supports", "contrasts", "weakly_aligned", "insufficient_relation"] },
          "window": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "pairRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "comparableBlocks": { "type": "integer", "minimum": 0 },
          "sameDirectionBlocks": { "type": "integer", "minimum": 0 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidenceBlockIds": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "x-preserveUnknownFields": true
      }
    },
    "personalSignature": {
      "type": ["object", "null"],
      "properties": {
        "status": { "enum": ["ready", "insufficient"] },
        "method": { "type": "string" },
        "windowDays": { "type": "integer", "minimum": 1 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "coverageDays": { "type": "integer", "minimum": 0 },
        "updatedAtMs": { "type": "integer", "minimum": 0 },
        "timezone": { "type": "string" },
        "typicalInterval": { "type": ["object", "null"] },
        "typicalDuration": { "type": ["object", "null"] },
        "typicalTimeBucket": { "type": ["object", "null"] },
        "commonObservations": { "type": "array", "items": { "type": "object" } },
        "variability": { "type": "object" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "x-preserveUnknownFields": true
    },
    "snapshotProtocol": {
      "type": "object",
      "required": ["dataRevision", "calculationPasses", "serializedOnce"],
      "properties": {
        "dataRevision": { "type": "integer", "minimum": 0 },
        "generatedAtMs": { "type": "integer", "minimum": 0 },
        "calculationPasses": { "const": 1 },
        "serializedOnce": { "const": true }
      }
    }
  }
}
