<!-- #204：开屏专用品牌锁定（01-C + 观己）；不直接复用 adaptive launcher，
     避免系统二次蒙版缩放。切片与高光分组供 AnimatedVectorDrawable 做轻微聚焦归位。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Android 12 会将启动图标裁切到中心安全区；缩放几何后为品牌字标留出同一安全区内的空间。 -->
    <!-- 上收图形而不下移字标，增加两者留白并保留字标下缘安全余量。 -->
    <group
        android:name="mark"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateY="-1.6">
    <group android:name="sliceTop">
        <path
            android:fillColor="#1689EE"
            android:fillAlpha="0.93"
            android:pathData="M21.9,35.4 L38.8,18.6 L86.1,65.8 L69.2,82.7 Z" />
    </group>
    <group android:name="sliceBottom">
        <path
            android:fillColor="#6FD1FF"
            android:fillAlpha="0.84"
            android:pathData="M21.9,72.8 L38.8,89.7 L86.1,47.0 L69.2,30.1 Z" />
    </group>
    <group android:name="sliceTopHighlight">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.30"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M25.6,33.2 L38.8,20.0 L82.8,64.0" />
    </group>
    <group android:name="sliceBottomHighlight">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.22"
            android:strokeWidth="1.7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M25.6,75.0 L38.8,88.2 L82.8,48.6" />
    </group>
    </group>
    <!-- #204：品牌字标从开屏首帧就存在，避免退出阶段才补文字造成跳变。 -->
