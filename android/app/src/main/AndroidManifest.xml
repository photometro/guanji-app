<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 桌面小组件（2x2） -->
        <receiver
            android:name=".GuanjiWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/guanji_widget_info" />
        </receiver>

        <!-- 数据看板小组件（#33） -->
        <receiver
            android:name=".GuanjiStatsWidget"
            android:exported="true"
            android:label="@string/stats_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stats_info" />
        </receiver>

        <!-- 本周节奏小组件（#34） -->
        <receiver
            android:name=".GuanjiWeekWidget"
            android:exported="true"
            android:label="@string/week_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <!-- 连续记录进度小组件（#35） -->
        <receiver
            android:name=".GuanjiStreakWidget"
            android:exported="true"
            android:label="@string/streak_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <!-- 今日卡片小组件（#36） -->
        <receiver
            android:name=".GuanjiTodayWidget"
            android:exported="true"
            android:label="@string/today_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 计时通知被划掉的标记接收器（#51，不拉起 App） -->
        <receiver
            android:name=".TimerDeleteReceiver"
            android:exported="false" />

        <!-- #60：计时前台服务（保活动态 contentText，OEM 息屏冻结根治） -->
        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="timer_recording" />
        </service>

        <!-- #60：计时更新闹钟接收器（息屏兜底，系统级触发） -->
        <receiver
            android:name=".TimerAlarmReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- #102：导出保存到公共 Downloads（Android 10+ MediaStore 无需权限；9 及以下需要，maxSdk 限定） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- #51：计时通知（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- #51：实况通知提升（Android 16+ 非运行时权限，低版本系统自动忽略） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- #60：计时前台服务（Android 14+ specialUse 类型要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
</manifest>

